# Copy to .env.local (never commit .env.local).

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser, RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY — bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Public site URL (used for QR codes, pass links, Stripe redirects) -----
# Optional locally; set it in production, e.g. https://book.easycutz.my
NEXT_PUBLIC_SITE_URL=

# --- Stripe (optional; enables deposit / pay-in-full with card + FPX) -------
# Both must be set or online payment options stay disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
